TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
TELEGRAM_TARGET_CHAT_ID=123456789
# Restrict bot commands to a single Telegram user id (strongly recommended:
# /digest and /news spend OpenAI credits).
ALLOWED_USER_ID=123456789
SEND_DEPLOY_NOTIFICATION=1
# AI for /news summaries, the daily digest and /digest scoring.
# NEWS_AI_PROVIDER: claude (default) | openai | deepseek. If the chosen
# provider's key is missing, the bot falls back to OpenAI.
NEWS_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Only for keys NOT created inside a workspace (API returns 400 "not scoped
# to a workspace"): the workspace id from platform.claude.com/settings/workspaces.
ANTHROPIC_WORKSPACE_ID=
# Default claude-opus-5-5. Cheaper: claude-sonnet-5-5, claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth: low (default) | medium | high | xhigh | max.
ANTHROPIC_EFFORT=low
# OpenAI: used when NEWS_AI_PROVIDER=openai, via "/news oa", or as fallback.
OPENAI_API_KEY=
# Any Chat Completions model; reasoning models (gpt-6*, gpt-5*, o1/o3/o4*)
# are handled automatically (max_completion_tokens, no custom temperature).
# Default is the mid-tier gpt-5.6-terra; gpt-6-astra is the top (pricey)
# model, gpt-5-mini / gpt-4o-mini are the cheap fallbacks.
OPENAI_MODEL=gpt-5.6-terra
# Only for reasoning models: low | medium | high | xhigh | max (default: low).
OPENAI_REASONING_EFFORT=
# Optional: analyst layer for /ideas (free key at finnhub.io).
FINNHUB_API_KEY=
# Optional: raises OpenFIGI rate limits for CUSIP->ticker mapping in /ideas.
OPENFIGI_API_KEY=
# SEC EDGAR requires "App Name your@email.com" in User-Agent (a URL instead
# of an e-mail gets 403 "Undeclared Automated Tool"). Set your real contact.
EDGAR_USER_AGENT=fear-greed-telegram-bot/1.0 you@example.com
LOG_LEVEL=INFO
